---
import "../styles/global.css";
import { withBase } from "../lib/markdown.js";

const {
  title = "Stock Research Reports",
  description = "深入了解上市公司的商业模式、财务表现与投资风险。",
  pageType = "inner",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const homeHref = withBase(base);
const valuationsHref = withBase(base, "valuations/");
const isValuationsPage = pageType === "valuations";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8f7" />
    <title>{title}</title>
  </head>
  <body class={pageType === "home" ? "home-page" : isValuationsPage ? "valuations-page" : "inner-page"}>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homeHref} aria-label="Stock Reports 首页">
          <span class="brand-mark">SR</span>
          <span class="brand-name">
            <strong>Stock Reports</strong>
            <small>Research Library</small>
          </span>
        </a>
        <nav class="primary-nav" aria-label="网站主导航">
          <a
            href={homeHref}
            class:list={["primary-nav-link", { "is-active": !isValuationsPage }]}
            aria-current={!isValuationsPage ? "page" : undefined}
          >研究报告</a>
          <a
            href={valuationsHref}
            class:list={["primary-nav-link", { "is-active": isValuationsPage }]}
            aria-current={isValuationsPage ? "page" : undefined}
          >情景估值</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
