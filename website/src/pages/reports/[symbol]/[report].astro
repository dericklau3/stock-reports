---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import index from "../../../data/report-index.json";
import { renderMarkdown, withBase } from "../../../lib/markdown.js";

export function getStaticPaths() {
  return index.companies.flatMap((company) =>
    company.reports.map((report) => ({
      params: { symbol: company.symbol, report: report.slug },
      props: { company, report },
    })),
  );
}

const { company, report } = Astro.props;
const base = import.meta.env.BASE_URL;
const reportHtml = renderMarkdown(report.content);
---

<BaseLayout title={`${report.title} · ${company.symbol}`}>
  <section class="report-head">
    <a class="back-link" href={withBase(base, `stocks/${company.symbol}/`)}>← 返回 {company.symbol}</a>
    <p class="eyebrow">{company.symbol} · {report.date || "Research Report"}</p>
    <h1>{report.title}</h1>
    <div class="detail-meta">
      <span>{company.companyName}</span>
      <span>{report.fileName}</span>
    </div>
  </section>

  <article class="markdown-body report-body" set:html={reportHtml} />

  <dialog id="event-detail-dialog" class="event-dialog" aria-labelledby="event-dialog-title">
    <div class="event-dialog-panel">
      <button type="button" class="event-dialog-close" aria-label="关闭事件详情">×</button>
      <p class="event-dialog-kicker">重大事件 · <span id="event-dialog-month"></span></p>
      <h2 id="event-dialog-title"></h2>
      <div id="event-dialog-content" class="event-dialog-content"></div>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector("#event-detail-dialog");
  const title = document.querySelector("#event-dialog-title");
  const month = document.querySelector("#event-dialog-month");
  const content = document.querySelector("#event-dialog-content");
  const closeButton = dialog?.querySelector(".event-dialog-close");
  let lastTrigger;

  // Native details remain usable if JS is disabled; with JS the same summary
  // becomes a button-like trigger for the accessible, modal HTML <dialog>.
  if (dialog && typeof dialog.showModal === "function") {
    for (const item of document.querySelectorAll(".report-body .event-roadmap .event-entry")) {
      const summary = item.querySelector(":scope > summary");
      const detail = item.querySelector(":scope > .event-detail-content");
      if (!summary || !detail) continue;

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        item.open = false;
        lastTrigger = summary;
        title.textContent =
          summary.querySelector(".event-entry-title")?.textContent?.trim() ||
          summary.textContent?.trim() ||
          "重大事件";
        month.textContent = item.closest(".event-month")?.dataset.month || "日期未核实";
        content.replaceChildren(...Array.from(detail.childNodes, (node) => node.cloneNode(true)));
        dialog.showModal();
        closeButton?.focus();
      });
    }

    for (const group of document.querySelectorAll(".report-body .event-roadmap .event-month")) {
      const count = group.querySelectorAll(":scope > .event-entry").length;
      const heading = group.querySelector(".event-month-heading");
      if (heading && !heading.querySelector(".event-month-count")) {
        const countLabel = document.createElement("span");
        countLabel.className = "event-month-count";
        countLabel.textContent = `${count} 项`;
        heading.append(countLabel);
      }
    }

    for (const roadmap of document.querySelectorAll(".report-body .event-roadmap")) {
      // Show newest months first when the timeline overflows: older months
      // remain accessible by scrolling left, preserving chronological order.
      roadmap.scrollLeft = roadmap.scrollWidth - roadmap.clientWidth;
    }
  }

  closeButton?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => lastTrigger?.focus());
</script>
