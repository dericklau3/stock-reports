---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { renderMarkdown, withBase } from "../../../lib/markdown.js";
import { intcConversation } from "../../../data/intc-conversation.js";

const base = import.meta.env.BASE_URL;
const homeHref = withBase(base);
const companyHref = withBase(base, "stocks/INTC/");
const reportHref = withBase(base, "reports/INTC/2026-11-06-deep-research/");
const questions = intcConversation.entries.map((item, index) => ({
  ...item,
  number: String(index + 1).padStart(2, "0"),
  html: renderMarkdown(item.answer),
}));
---

<BaseLayout
  title="INTC专题问答｜CEO、18A/14A、Terafab、Fab 34与Classiq · Stock Reports"
  description="关于英特尔INTC的专题问答：CEO改革、NVIDIA战略投资、18A/14A工艺、Terafab项目合作、Fab 34股权回购、Classiq量子计算与先进封装基板供应协议。"
>
  <div class="conversation-page">
    <nav class="conversation-breadcrumbs" aria-label="面包屑导航">
      <a href={homeHref}>股票列表</a><span aria-hidden="true">/</span>
      <a href={companyHref}>INTC · Intel</a><span aria-hidden="true">/</span>
      <span aria-current="page">专题问答</span>
    </nav>

    <header class="conversation-head">
      <div class="conversation-head-copy">
        <p class="conversation-kicker"><span></span> STOCK RESEARCH / DISCUSSION</p>
        <h1>英特尔<span>深度问答</span></h1>
        <p class="conversation-subtitle">{intcConversation.subtitle}</p>
        <div class="conversation-head-links">
          <a href={reportHref} class="conversation-primary-link">阅读完整深度报告 <span aria-hidden="true">↗</span></a>
          <a href={companyHref} class="conversation-secondary-link">返回INTC公司页</a>
        </div>
      </div>
      <div class="conversation-head-meta" aria-label="专题信息">
        <div><span>内容整理</span><strong>{intcConversation.lastEdited}</strong></div>
        <div><span>基础研究截止</span><strong>{intcConversation.researchCutoff}</strong></div>
        <div><span>讨论主题</span><strong>{questions.length} 个问题</strong></div>
      </div>
    </header>

    <div class="conversation-quickfacts" aria-label="这组问答中的关键数字">
      <div><span class="quickfact-label">现任CEO</span><strong>陈立武</strong><small>2025-03-18 上任</small></div>
      <div><span class="quickfact-label">CEO主动买入</span><strong>$10.00M</strong><small>2026-08-11 · $95/股</small></div>
      <div><span class="quickfact-label">NVIDIA入股Intel</span><strong>$5.00B</strong><small>2025-12-26 交割</small></div>
      <div><span class="quickfact-label">Fab 34股权回购</span><strong>$14.2B</strong><small>2026-04-08 · 回购49%</small></div>
    </div>

    <div class="conversation-layout">
      <aside class="conversation-toc" aria-label="问答目录">
        <p class="conversation-toc-label">专题目录 <span>{questions.length} 个问题</span></p>
        <nav aria-label="跳转到问题">
          {questions.map((item) => (
            <a href={"#" + item.id}>
              <span class="toc-num">{item.number}</span>
              <span>{item.topic}</span>
            </a>
          ))}
        </nav>
        <p class="conversation-toc-note">本页基于研究对话整理，非实时股价或实时持仓。点击左侧主题可跳转阅读。</p>
      </aside>

      <div class="conversation-feed">
        {questions.map((item) => (
          <section id={item.id} class="conversation-question" aria-labelledby={item.id + "-title"}>
            <div class="question-topline">
              <span class="question-number">QUESTION {item.number}</span>
              <span class="question-topic">{item.topic}</span>
            </div>
            <div class="conversation-user">
              <span class="conversation-role">提问</span>
              <h2 id={item.id + "-title"}>{item.question}</h2>
            </div>
            <div class="conversation-response">
              <div class="conversation-response-head">
                <span class="response-mark" aria-hidden="true">SR</span>
                <span>研究解答</span>
                <span class="response-time">资料截至 {item.researchCutoff || intcConversation.researchCutoff}</span>
              </div>
              <div class="markdown-body conversation-copy" set:html={item.html} />
            </div>
          </section>
        ))}
        <div class="conversation-end">
          <strong>继续深入研究 Intel</strong>
          <p>详细财报、分部收入、现金流、历史估值及风险假设请以完整研究报告和SEC原始文件为准。</p>
          <a href={reportHref}>查看INTC完整深研 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .conversation-page { max-width: 1180px; margin: 0 auto; }
  .conversation-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; margin-bottom: 1.5rem; color: #77897f; font-size: .83rem; }
  .conversation-breadcrumbs a { text-decoration: none; color: #326a53; }
  .conversation-breadcrumbs a:hover { text-decoration: underline; }
  .conversation-head { display: flex; align-items: end; justify-content: space-between; gap: 1.6rem; padding: 0 0 1.65rem; border-bottom: 1px solid #dce6df; }
  .conversation-head-copy { flex: 1; min-width: 0; }
  .conversation-kicker { display: flex; align-items: center; gap: .55rem; margin: 0 0 .9rem; color: #147653; font-size: .7rem; font-weight: 800; letter-spacing: .14em; }
  .conversation-kicker span { display: inline-block; width: 22px; height: 2px; background: #169866; }
  .conversation-head h1 { color: #182b22; margin: 0 0 .7rem; font-size: clamp(2.1rem, 4vw, 3.15rem); line-height: 1.18; letter-spacing: -.045em; }
  .conversation-head h1 span { color: #2b8a62; }
  .conversation-subtitle { max-width: 680px; color: #5d7164; line-height: 1.7; font-size: .98rem; margin: 0 0 1.05rem; }
  .conversation-head-links { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .conversation-primary-link { display: inline-flex; gap: .45rem; align-items: center; border-radius: 8px; background: #0f634a; color: #fff; padding: .65rem .85rem; font-size: .85rem; font-weight: 700; text-decoration: none; }
  .conversation-primary-link:hover { background: #084934; }
  .conversation-secondary-link { color: #4c6756; font-size: .84rem; font-weight: 650; text-decoration: none; }
  .conversation-secondary-link:hover { text-decoration: underline; }
  .conversation-head-meta { display: grid; gap: .7rem; width: 200px; padding: .65rem 0 .65rem 1.3rem; border-left: 1px solid #e0e6e2; flex-shrink: 0; }
  .conversation-head-meta div { display: grid; gap: .2rem; }
  .conversation-head-meta span { color: #7a8981; font-size: .7rem; }
  .conversation-head-meta strong { font-size: .84rem; color: #263d30; font-variant-numeric: tabular-nums; }
  .conversation-quickfacts { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 0; margin: 1.25rem 0 2rem; border: 1px solid #dfe8e1; border-radius: 11px; background: #fff; overflow: hidden; }
  .conversation-quickfacts > div { display: grid; gap: .3rem; min-width: 0; padding: 1.1rem 1.15rem; }
  .conversation-quickfacts > div + div { border-left: 1px solid #e6ece7; }
  .quickfact-label { color: #688072; font-size: .73rem; }
  .conversation-quickfacts strong { color: #153d2b; font-size: 1.4rem; letter-spacing: -.025em; font-variant-numeric: tabular-nums; }
  .conversation-quickfacts small { color: #84958a; font-size: .72rem; line-height: 1.35; }
  .conversation-layout { display: grid; grid-template-columns: 195px minmax(0, 1fr); align-items: start; gap: 1.7rem; }
  .conversation-toc { position: sticky; top: 5.4rem; }
  .conversation-toc-label { display: flex; justify-content: space-between; margin: 0 0 .7rem; color: #243c2e; font-size: .86rem; font-weight: 800; }
  .conversation-toc-label span { color: #829088; font-size: .7rem; font-weight: 500; }
  .conversation-toc nav { display: grid; gap: .12rem; border-left: 1px solid #dfe8e2; }
  .conversation-toc nav a { display: flex; align-items: center; gap: .75rem; padding: .72rem .55rem .72rem .8rem; margin-left: -1px; border-left: 2px solid transparent; text-decoration: none; color: #667b70; font-size: .84rem; }
  .conversation-toc nav a:hover, .conversation-toc nav a:focus-visible { color: #0c6e4d; border-left-color: #0c8060; background: #edf6f0; }
  .toc-num { font-size: .7rem; font-variant-numeric: tabular-nums; color: #93a39b; font-weight: 800; }
  .conversation-toc-note { margin: 1.2rem 0 0; color: #87978e; font-size: .74rem; line-height: 1.7; }
  .conversation-feed { min-width: 0; display: grid; gap: 1.2rem; }
  .conversation-question { scroll-margin-top: 5.5rem; overflow: hidden; border: 1px solid #dfe8e2; border-radius: 12px; background: #fff; box-shadow: 0 3px 15px rgba(22,50,36,.03); }
  .question-topline { display: flex; justify-content: space-between; padding: 1.2rem 1.6rem 0; gap: 1rem; color: #8a9b91; font-size: .68rem; font-weight: 800; letter-spacing: .06em; }
  .question-topic { color: #187454; letter-spacing: 0; }
  .conversation-user { padding: .6rem 1.6rem 1.15rem; border-bottom: 1px solid #edf0ed; }
  .conversation-role { display: inline-block; margin-bottom: .5rem; color: #7a8c80; font-size: .7rem; font-weight: 700; }
  .conversation-user h2 { margin: 0; color: #192f23; font-size: clamp(1.22rem, 2.2vw, 1.52rem); line-height: 1.45; letter-spacing: -.02em; }
  .conversation-response { padding: 1.35rem 1.6rem 1.4rem; }
  .conversation-response-head { display: flex; align-items: center; gap: .55rem; color: #3e6f56; font-size: .76rem; font-weight: 750; margin-bottom: 1.1rem; }
  .response-mark { display: grid; place-items: center; height: 23px; width: 23px; border-radius: 6px; color: white; background: #0d6548; font-size: .62rem; font-family: Georgia, serif; }
  .response-time { margin-left: auto; color: #89978e; font-size: .68rem; font-weight: 450; }
  .conversation-copy { border: 0; border-radius: 0; background: transparent; box-shadow: none; padding: 0; max-width: none; font-size: .94rem; }
  .conversation-copy :global(p), .conversation-copy :global(li) { color: #31443a; line-height: 1.86; }
  .conversation-copy :global(p:last-child) { margin-bottom: 0; }
  .conversation-copy :global(p:first-child) { margin-top: 0; }
  .conversation-copy :global(table) { font-size: .83rem; }
  .conversation-copy :global(th), .conversation-copy :global(td) { min-width: 90px; padding: .65rem .7rem; }
  .conversation-copy :global(h2) { margin-top: 1.2rem; font-size: 1.15rem; }
  .conversation-copy :global(a) { overflow-wrap: anywhere; }
  .conversation-end { padding: 1.6rem; border: 1px solid #dce8de; border-radius: 12px; background: #f1f7f2; }
  .conversation-end strong { color: #183c2b; font-size: 1.04rem; }
  .conversation-end p { margin: .65rem 0 1rem; color: #536d5b; line-height: 1.7; font-size: .9rem; }
  .conversation-end a { color: #08764f; font-weight: 750; text-decoration: none; }
  .conversation-end a:hover { text-decoration: underline; }
  @media (max-width: 850px) {
    .conversation-layout { grid-template-columns: 1fr; gap: 1rem; }
    .conversation-toc { position: static; }
    .conversation-toc nav { display: flex; overflow-x: auto; border-left: none; border-bottom: 1px solid #dfe8e2; padding-bottom: .3rem; scrollbar-width: thin; }
    .conversation-toc nav a { flex: 0 0 auto; margin-left: 0; border-left: 0; border-bottom: 2px solid transparent; padding: .65rem .7rem; }
    .conversation-toc nav a:hover, .conversation-toc nav a:focus-visible { border-left: 0; border-bottom-color: #0c8060; }
    .conversation-toc-note { display: none; }
  }
  @media (max-width: 660px) {
    .conversation-head { flex-direction: column; align-items: start; gap: 1rem; }
    .conversation-head-meta { display: flex; flex-wrap: wrap; gap: 1.1rem; width: 100%; border-left: 0; border-top: 1px solid #e0e6e2; padding: .85rem 0 0; }
    .conversation-quickfacts { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .conversation-quickfacts > div:nth-child(3) { border-left: 0; border-top: 1px solid #e6ece7; }
    .conversation-quickfacts > div:nth-child(4) { border-top: 1px solid #e6ece7; }
    .question-topline { padding: 1rem 1.1rem 0; }
    .conversation-user { padding: .65rem 1.1rem 1.1rem; }
    .conversation-response { padding: 1.15rem 1.1rem; }
    .response-time { display: none; }
    .conversation-copy { font-size: .9rem; }
    .conversation-quickfacts > div { padding: .8rem .9rem; }
    .conversation-quickfacts strong { font-size: 1.16rem; }
  }
</style>
