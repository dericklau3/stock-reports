---
import BaseLayout from "../../layouts/BaseLayout.astro";
import index from "../../data/report-index.json";
import { renderMarkdown, reportUrl, rewriteResearchLinks, withBase } from "../../lib/markdown.js";

export function getStaticPaths() {
  return index.companies.map((company) => ({
    params: { symbol: company.symbol },
    props: { company },
  }));
}

const { company } = Astro.props;
const base = import.meta.env.BASE_URL;
const trackerHtml = renderMarkdown(rewriteResearchLinks(company.tracker.content, base, company.symbol));
const investmentView = company.investmentView || "研究中";
const investmentTone = /看空|偏空/.test(investmentView)
  ? "negative"
  : /谨慎|观望/.test(investmentView)
    ? "cautious"
    : /看多|看好|建设性|积极|偏多/.test(investmentView)
      ? "positive"
      : "neutral";
const viewMeaning = investmentView === "研究中"
  ? "报告尚未使用标准化方向标签，不等于中性。"
  : /中性.*谨慎|谨慎中性/.test(investmentView)
    ? "整体判断接近中性，但更重视估值与下行风险。"
    : /中性.*建设性|中性.*积极/.test(investmentView)
      ? "整体判断接近中性，对经营前景略偏积极。"
      : /中性/.test(investmentView)
        ? "正反因素相对均衡，暂未形成明显的看多或看空判断。"
        : /看空|偏空/.test(investmentView)
          ? "当前更关注负面因素与潜在下行风险。"
          : /谨慎|观望/.test(investmentView)
            ? "当前侧重风险控制，等待更有力的经营或估值证据。"
            : "观点相对积极，但并不意味着价格必然上涨。";
---

<BaseLayout title={`${company.symbol} · ${company.companyName}`}>
  <section class="detail-head">
    <a class="back-link" href={withBase(base)}>← 返回股票列表</a>
    <div class="detail-title">
      <div>
        <p class="eyebrow">{company.symbol}</p>
        <h1>{company.companyName}</h1>
      </div>
      <span class="report-pill">{company.reports.length} reports</span>
    </div>
    <div class="investment-summary" aria-label="投资观点">
      <span class="investment-heading">投资观点</span>
      <strong class:list={["investment-rating", "investment-rating-" + investmentTone]}>{investmentView}</strong>
      <span class="investment-meaning">{viewMeaning}</span>
      <details class="view-glossary">
        <summary>观点含义</summary>
        <dl>
          <div><dt>研究中</dt><dd>还没有可明确归类的观点；不是中性，也不代表没有报告。</dd></div>
          <div><dt>看多 / 看好</dt><dd>经营和估值证据支持相对积极的判断，但不保证上涨。</dd></div>
          <div><dt>中性</dt><dd>利好与风险相互制衡，暂无明确的看多或看空倾向。</dd></div>
          <div><dt>中性偏建设性 / 中性偏谨慎</dt><dd>以中性为基础，分别略偏积极或略偏防守。</dd></div>
          <div><dt>谨慎 / 看空</dt><dd>更加关注风险；看空表示负面判断更明确。</dd></div>
        </dl>
        <p>所有观点均为研究判断，不构成买卖建议。</p>
      </details>
    </div>
  </section>

  <section class="two-column">
    <aside class="report-list-panel">
      {company.symbol === "INTC" && (
        <a class="conversation-feature" href={withBase(base, "stocks/INTC/conversation/")}>
          <span class="conversation-feature-kicker">INTC · 专题问答</span>
          <strong>陈立武改革、NVIDIA投资与公开交易</strong>
          <span class="conversation-feature-summary">3个专题 · 管理改革、公开交易、战略投资</span>
          <span class="conversation-feature-action">阅读专题 →</span>
        </a>
      )}
      <h2>研究报告</h2>
      <div class="report-list">
        {
          company.reports.map((report) => (
            <a href={reportUrl(base, company.symbol, report.fileName)}>
              <span>{report.date || report.slug}</span>
              <strong>{report.title}</strong>
            </a>
          ))
        }
      </div>
    </aside>

    <article class="markdown-body tracker-body" set:html={trackerHtml} />
  </section>
</BaseLayout>

<style>
  .investment-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem .85rem;
    margin-top: 1.15rem;
  }
  .investment-heading { color: #708278; font-size: .85rem; font-weight: 750; }
  .investment-rating {
    padding: .34rem .75rem;
    border-radius: 999px;
    background: #edf2ee;
    color: #426b55;
    font-size: .94rem;
    font-weight: 800;
  }
  .investment-rating-positive { background: #eaf6ee; color: #176d48; }
  .investment-rating-cautious { background: #fbf0e1; color: #955c1e; }
  .investment-rating-negative { background: #fbe9e8; color: #a13d36; }
  .investment-meaning { color: #65766b; font-size: .85rem; line-height: 1.5; }
  .view-glossary { flex-basis: 100%; font-size: .8rem; }
  .view-glossary > summary {
    display: inline-flex;
    cursor: pointer;
    color: #087451;
    font-weight: 750;
    list-style-position: inside;
    padding: .25rem 0;
  }
  .view-glossary[open] { margin-top: .25rem; }
  .view-glossary dl {
    display: grid;
    gap: .6rem;
    max-width: 740px;
    margin: .55rem 0;
    padding: .85rem 1rem;
    border: 1px solid #e1eae2;
    border-radius: 9px;
    background: #f8faf8;
  }
  .view-glossary dl > div { display: grid; grid-template-columns: minmax(125px, auto) 1fr; gap: .8rem; }
  .view-glossary dt { font-weight: 750; color: #2e5742; }
  .view-glossary dd { margin: 0; color: #64746a; }
  .view-glossary p { margin: .4rem 0 0; color: #78887c; }
  @media (max-width: 560px) {
    .investment-meaning { flex-basis: 100%; }
    .view-glossary dl > div { grid-template-columns: 1fr; gap: .15rem; }
  }
  .conversation-feature {
    display: grid;
    gap: .48rem;
    margin-bottom: 1.25rem;
    border: 1px solid #cfe2d5;
    border-radius: 9px;
    background: linear-gradient(135deg, #f5faf6, #fff);
    padding: 1rem;
    text-decoration: none;
  }
  .conversation-feature:hover, .conversation-feature:focus-visible {
    border-color: #53a27c;
    box-shadow: 0 4px 16px rgba(13, 105, 66, .09);
  }
  .conversation-feature-kicker {
    color: #168055; font-size: .71rem; font-weight: 800; letter-spacing: .03em;
  }
  .conversation-feature strong { color: #233b2c; font-size: .99rem; line-height: 1.48; }
  .conversation-feature-summary { color: #76877b; font-size: .76rem; line-height: 1.5; }
  .conversation-feature-action { color: #0b7851; font-size: .83rem; font-weight: 800; }
</style>
