---
import BaseLayout from "../../layouts/BaseLayout.astro";
import index from "../../data/report-index.json";
import { renderMarkdown, reportUrl, withBase } from "../../lib/markdown.js";
import { intcConversation } from "../../data/intc-conversation.js";

export function getStaticPaths() {
  return index.companies.map((company) => ({
    params: { symbol: company.symbol },
    props: { company },
  }));
}

const { company } = Astro.props;
const base = import.meta.env.BASE_URL;
const topics = company.symbol === "INTC" ? intcConversation.entries : [];
const topicCutoff = company.symbol === "INTC" ? intcConversation.researchCutoff : "";
const investmentView = company.investmentView || "研究中";
const investmentTone = /看空|偏空/.test(investmentView)
  ? "negative"
  : /谨慎|观望/.test(investmentView)
    ? "cautious"
    : /看多|看好|建设性|积极|偏多/.test(investmentView)
      ? "positive"
      : "neutral";
const viewMeaning = investmentView === "研究中"
  ? "报告尚未使用标准化方向标签，不等于中性。"
  : /中性.*谨慎|谨慎中性/.test(investmentView)
    ? "整体判断接近中性，但更重视估值与下行风险。"
    : /中性.*建设性|中性.*积极/.test(investmentView)
      ? "整体判断接近中性，对经营前景略偏积极。"
      : /中性/.test(investmentView)
        ? "正反因素相对均衡，暂未形成明显的看多或看空判断。"
        : /看空|偏空/.test(investmentView)
          ? "当前更关注负面因素与潜在下行风险。"
          : /谨慎|观望/.test(investmentView)
            ? "当前侧重风险控制，等待更有力的经营或估值证据。"
            : "观点相对积极，但并不意味着价格必然上涨。";
---

<BaseLayout title={`${company.symbol} · ${company.companyName}`}>
  <section class="detail-head">
    <a class="back-link" href={withBase(base)}>← 返回股票列表</a>
    <div class="detail-title">
      <div>
        <p class="eyebrow">{company.symbol}</p>
        <h1>{company.companyName}</h1>
      </div>
      <span class="report-pill">{company.reports.length} reports</span>
    </div>
    <div class="investment-summary" aria-label="投资观点">
      <span class="investment-heading">投资观点</span>
      <strong class:list={["investment-rating", "investment-rating-" + investmentTone]}>{investmentView}</strong>
      <span class="investment-meaning">{viewMeaning}</span>
      <details class="view-glossary">
        <summary>观点含义</summary>
        <dl>
          <div><dt>研究中</dt><dd>还没有可明确归类的观点；不是中性，也不代表没有报告。</dd></div>
          <div><dt>看多 / 看好</dt><dd>经营和估值证据支持相对积极的判断，但不保证上涨。</dd></div>
          <div><dt>中性</dt><dd>利好与风险相互制衡，暂无明确的看多或看空倾向。</dd></div>
          <div><dt>中性偏建设性 / 中性偏谨慎</dt><dd>以中性为基础，分别略偏积极或略偏防守。</dd></div>
          <div><dt>谨慎 / 看空</dt><dd>更加关注风险；看空表示负面判断更明确。</dd></div>
        </dl>
        <p>所有观点均为研究判断，不构成买卖建议。</p>
      </details>
    </div>
  </section>

  <section class="two-column">
    <aside class="report-list-panel">
      <h2>研究报告</h2>
      <div class="report-list">
        {
          company.reports.map((report) => (
            <a href={reportUrl(base, company.symbol, report.fileName)}>
              <span>{report.date || report.slug}</span>
              <strong>{report.title}</strong>
            </a>
          ))
        }
      </div>
    </aside>

    <article class="topic-panel" aria-labelledby="topic-panel-heading">
      <div class="topic-panel-head">
        <div>
          <p class="topic-kicker">STOCK DISCUSSION</p>
          <h2 id="topic-panel-heading">专题问题</h2>
          <p class="topic-panel-description">围绕公司重要经营决策、资本交易和投资疑问的专题研究。</p>
        </div>
        {topics.length > 0 && (
          <span class="topic-count">{topics.length} 个专题</span>
        )}
      </div>
      {topics.length > 0 ? (
        <div class="topic-list">
          {topics.map((topic, i) => (
            <details class="topic-entry" id={topic.id}>
              <summary>
                <span class="topic-number">{String(i + 1).padStart(2, "0")}</span>
                <span class="topic-copy">
                  <span class="topic-category">{topic.topic}</span>
                  <strong>{topic.question}</strong>
                </span>
                <span class="topic-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="topic-answer-wrapper">
                <p class="topic-source-date">研究资料截至 {topicCutoff}，不代表实时行情或实时持仓。</p>
                <div class="markdown-body topic-answer" set:html={renderMarkdown(topic.answer)} />
              </div>
            </details>
          ))}
          {company.symbol === "INTC" && (
            <a class="topic-full-link" href={withBase(base, "stocks/INTC/conversation/")}>
              查看完整专题页面 →
            </a>
          )}
        </div>
      ) : (
        <div class="topic-empty">
          <p>这只股票暂时没有独立整理的专题问题。</p>
          <p>可以先阅读左侧的最新深度研究报告。</p>
        </div>
      )}
    </article>
  </section>
</BaseLayout>

<style>
  .investment-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem .85rem;
    margin-top: 1.15rem;
  }
  .investment-heading { color: #708278; font-size: .85rem; font-weight: 750; }
  .investment-rating {
    padding: .34rem .75rem;
    border-radius: 999px;
    background: #edf2ee;
    color: #426b55;
    font-size: .94rem;
    font-weight: 800;
  }
  .investment-rating-positive { background: #eaf6ee; color: #176d48; }
  .investment-rating-cautious { background: #fbf0e1; color: #955c1e; }
  .investment-rating-negative { background: #fbe9e8; color: #a13d36; }
  .investment-meaning { color: #65766b; font-size: .85rem; line-height: 1.5; }
  .view-glossary { flex-basis: 100%; font-size: .8rem; }
  .view-glossary > summary {
    display: inline-flex;
    cursor: pointer;
    color: #087451;
    font-weight: 750;
    list-style-position: inside;
    padding: .25rem 0;
  }
  .view-glossary[open] { margin-top: .25rem; }
  .view-glossary dl {
    display: grid;
    gap: .6rem;
    max-width: 740px;
    margin: .55rem 0;
    padding: .85rem 1rem;
    border: 1px solid #e1eae2;
    border-radius: 9px;
    background: #f8faf8;
  }
  .view-glossary dl > div { display: grid; grid-template-columns: minmax(125px, auto) 1fr; gap: .8rem; }
  .view-glossary dt { font-weight: 750; color: #2e5742; }
  .view-glossary dd { margin: 0; color: #64746a; }
  .view-glossary p { margin: .4rem 0 0; color: #78887c; }
  @media (max-width: 560px) {
    .investment-meaning { flex-basis: 100%; }
    .view-glossary dl > div { grid-template-columns: 1fr; gap: .15rem; }
  }
  .topic-panel {
    min-width: 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid #dce7df;
    border-radius: 12px;
    background: #fff;
  }
  .topic-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid #e2eae4;
  }
  .topic-kicker {
    margin-bottom: .5rem;
    color: #187351;
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .07em;
  }
  .topic-panel-head h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    line-height: 1.2;
    color: #1d3427;
  }
  .topic-panel-description {
    margin: .65rem 0 0;
    color: #718077;
    font-size: .87rem;
    line-height: 1.65;
  }
  .topic-count {
    padding: .3rem .6rem;
    border-radius: 999px;
    background: #edf5ef;
    color: #176f4d;
    font-size: .74rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .topic-list { display: grid; gap: .85rem; margin-top: 1.3rem; }
  .topic-entry {
    border: 1px solid #e1e9e3;
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
  }
  .topic-entry[open] { border-color: #99c6ac; box-shadow: 0 7px 18px rgba(24, 78, 48, .05); }
  .topic-entry > summary {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem;
    list-style: none;
    cursor: pointer;
  }
  .topic-entry > summary::-webkit-details-marker { display: none; }
  .topic-entry > summary:hover { background: #f7faf7; }
  .topic-number { padding-top: .12rem; color: #80aa90; font-size: .9rem; font-weight: 850; }
  .topic-copy { display: grid; flex: 1; gap: .45rem; min-width: 0; }
  .topic-category { font-size: .7rem; font-weight: 800; color: #147851; }
  .topic-copy strong { color: #27392e; font-size: 1rem; line-height: 1.6; }
  .topic-toggle { font-size: 1.2rem; color: #287c53; font-weight: 500; }
  .topic-entry[open] .topic-toggle { transform: rotate(45deg); }
  .topic-answer-wrapper { padding: 1rem 1.15rem 1.3rem; border-top: 1px solid #e7efe9; }
  .topic-source-date { color: #73837b; font-size: .78rem; }
  .topic-answer { border: 0; padding: 0; font-size: .9rem; overflow-x: auto; }
  .topic-answer h2 { margin-top: 1.5rem; }
  .topic-full-link { justify-self: start; font-size: .84rem; color: #126c4e; font-weight: 750; text-decoration: none; }
  .topic-full-link:hover { text-decoration: underline; }
  .topic-empty { padding: 2.5rem 1rem; text-align: center; color: #74877a; }
  .topic-empty p { margin: 0 0 .45rem; }
  @media (max-width: 680px) {
    .topic-entry > summary { padding: 1rem .8rem; gap: .65rem; }
    .topic-panel { padding: 1rem; }
  }
</style>
