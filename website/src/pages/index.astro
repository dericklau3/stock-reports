---
import BaseLayout from "../layouts/BaseLayout.astro";
import index from "../data/report-index.json";
import earningsCalendar from "../data/earnings-q3-2026.json";
import { withBase } from "../lib/markdown.js";

const base = import.meta.env.BASE_URL;
const companies = [...index.companies].sort((a, b) =>
  (b.lastUpdated || "").localeCompare(a.lastUpdated || "") || a.symbol.localeCompare(b.symbol),
);
const quarterEarnings = earningsCalendar.entries;
const earningsStateText = { reported: "已公布", scheduled: "即将公布", unannounced: "待官宣", "not-applicable": "无业绩会" };
const reportCount = companies.reduce((total, company) => total + company.reports.length, 0);
const latestUpdated = companies.find((company) => company.lastUpdated)?.lastUpdated || "—";

const groupBySymbol = {
  INTC: ["semiconductors", "ai"], NVDA: ["semiconductors", "ai"],
  QCOM: ["semiconductors"], SKHY: ["semiconductors", "ai"],
  CBRS: ["semiconductors", "ai"], MU: ["semiconductors"],
  AAPL: ["consumer"], TSLA: ["consumer", "ai"], AMZN: ["consumer", "cloud"],
  GOOG: ["ai", "cloud"], MSFT: ["ai", "cloud"], ORCL: ["cloud", "ai"],
  PL: ["ai"], TEM: ["ai"], HOOD: ["consumer"],
  LMND: ["consumer", "ai"], CRCL: ["consumer"],
};
const shortName = {
  INTC: "Intel", PL: "Planet Labs PBC", AMZN: "Amazon",
  GOOG: "Alphabet", HOOD: "Robinhood Markets",
  SPCX: "Space Exploration Technologies", TSLA: "Tesla",
  AAPL: "Apple",
};

function toneFromView(value) {
  const view = (value || "").trim();
  if (/看空|偏空|谨慎|观望/.test(view)) return "cautious";
  if (/看多|看好|积极|建设性|乐观|偏多/.test(view)) return "positive";
  return "neutral";
}
---

<BaseLayout title="股票研究报告 · Stock Reports" pageType="home" description="浏览上市公司深度研究报告、商业模式、关键事件、财务表现、估值及投资风险。">
  <section class="library-content" id="stock-library" aria-labelledby="home-title">
    <div class="library-intro">
      <div class="library-intro-copy">
        <p class="intro-eyebrow"><span aria-hidden="true"></span> RESEARCH LIBRARY</p>
        <h1 id="home-title">股票研究报告</h1>
        <p class="intro-description">聚合上市公司深度研究，快速查看投资观点、商业模式、财务表现与核心风险。</p>
      </div>
      <dl class="overview-stats">
        <div class="overview-stat">
          <dt>{companies.length}</dt>
          <dd>覆盖股票</dd>
        </div>
        <div class="overview-stat">
          <dt>{reportCount}</dt>
          <dd>研究报告</dd>
        </div>
        <div class="overview-stat overview-stat-date">
          <dt>{latestUpdated}</dt>
          <dd>最近更新</dd>
        </div>
      </dl>
    </div>

    <div class="library-controls">
      <form class="library-search" id="stock-search-form" role="search" aria-label="搜索股票">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 5 5"/>
        </svg>
        <label class="sr-only" for="stock-search">搜索股票代码或公司名称</label>
        <input id="stock-search" type="search" autocomplete="off" placeholder="搜索股票代码或公司名称，例如 AAPL、PL、Intel" />
        <button type="submit">搜索</button>
      </form>

      <div class="filter-bar" role="group" aria-label="报告分类筛选">
        <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">全部</button>
        <button type="button" class="filter-chip" data-filter="semiconductors" aria-pressed="false"><span aria-hidden="true">▦</span> 半导体</button>
        <button type="button" class="filter-chip" data-filter="ai" aria-pressed="false"><span aria-hidden="true">✧</span> AI</button>
        <button type="button" class="filter-chip" data-filter="consumer" aria-pressed="false"><span aria-hidden="true">◈</span> 消费</button>
        <button type="button" class="filter-chip" data-filter="cloud" aria-pressed="false"><span aria-hidden="true">☁</span> 云计算</button>
      </div>
    </div>

    <div class="library-section-head">
      <div class="library-section-heading">
        <span class="section-bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2 id="library-title">研究报告库</h2>
      </div>
      <div class="library-section-tools">
        <span class="result-count" id="result-count" role="status" aria-live="polite">共 {companies.length} 只股票 · {reportCount} 份研究报告</span>
        <div class="view-switch" role="group" aria-label="切换展示方式">
          <button type="button" data-view="grid" class="is-active" aria-label="网格视图" aria-pressed="true">▦</button>
          <button type="button" data-view="list" aria-label="列表视图" aria-pressed="false">☰</button>
        </div>
      </div>
    </div>

    <section class="stock-grid" id="stock-grid" aria-label="股票研究报告">
      {companies.map((company) => (
        <a
          class="stock-card"
          href={withBase(base, "stocks/" + company.symbol + "/")}
          data-stock-card
          data-report-count={company.reports.length}
          aria-label={`${company.symbol} · ${shortName[company.symbol] || company.companyName}，投资观点：${company.investmentView || "研究中"}`}
          data-updated={company.lastUpdated || ""}
          data-categories={(groupBySymbol[company.symbol] || []).join(" ")}
          data-symbol={company.symbol}
          data-company-name={[company.companyName, shortName[company.symbol] || ""].join(" ")}
        >
          <div class="stock-card-top">
            <div class="stock-identity">
              <strong class="ticker">{company.symbol}</strong>
              <span class="stock-company">{shortName[company.symbol] || company.companyName}</span>
            </div>
          </div>
          <div class="stock-card-middle">
            <span class:list={["view-tag", "view-tag-" + toneFromView(company.investmentView || "研究中")]}>{company.investmentView || "研究中"}</span>
            {company.lastUpdated && (
              <span class="latest-report-date">
                <span>最新报告</span>
                <time datetime={company.lastUpdated}>{company.lastUpdated}</time>
              </span>
            )}
          </div>
          {quarterEarnings[company.symbol] && (
            <div
              class="stock-card-earnings"
              data-earnings-status={quarterEarnings[company.symbol].status}
              title={`财报季度：${quarterEarnings[company.symbol].quarter}。日期按美国当地日期；资料来源：${quarterEarnings[company.symbol].source}`}
            >
              <span class="earnings-quarter">{quarterEarnings[company.symbol].quarter} 财报</span>
              <span class="earnings-schedule">
                {quarterEarnings[company.symbol].date ? (
                  <time class="earnings-date" datetime={quarterEarnings[company.symbol].date}>{quarterEarnings[company.symbol].date}</time>
                ) : (
                  <span class="earnings-date">{quarterEarnings[company.symbol].status === "not-applicable" ? "不适用" : "日期待公告"}</span>
                )}
                <span class:list={["earnings-status", "earnings-status-" + quarterEarnings[company.symbol].status]}>
                  {earningsStateText[quarterEarnings[company.symbol].status]}
                </span>
              </span>
            </div>
          )}
        </a>
      ))}
    </section>
    <p class="earnings-date-note">财报日期按美国当地日期展示；部分公司财年与自然季度不同。未正式宣布的日期不采用第三方预测。</p>
    <div id="no-results" class="no-results" hidden>
      <span aria-hidden="true">⌕</span>
      <h3>没有找到匹配的股票</h3>
      <p>试试其他股票代码、公司名称，或切换分类。</p>
      <button type="button" id="reset-filters">清除筛选</button>
    </div>
  </section>

  <script>
    import { findMatchingStocks } from "../lib/stock-search.js";

    const search = document.querySelector("#stock-search");
    const form = document.querySelector("#stock-search-form");
    const grid = document.querySelector("#stock-grid");
    const cards = Array.from(document.querySelectorAll("[data-stock-card]"));
    const chips = Array.from(document.querySelectorAll(".filter-chip"));
    const views = Array.from(document.querySelectorAll("[data-view]"));
    const count = document.querySelector("#result-count");
    const empty = document.querySelector("#no-results");
    let activeFilter = "all";

    function applyFilters() {
      const query = search?.value.trim() || "";
      const matchedSymbols = new Set(
        findMatchingStocks(
          cards.map((card) => ({
            symbol: card.dataset.symbol || "",
            companyName: card.dataset.companyName || "",
          })),
          query,
        ).map((company) => company.symbol),
      );
      let visible = 0;
      let reports = 0;
      for (const card of cards) {
        const matchesText = matchedSymbols.has(card.dataset.symbol || "");
        let matchesCategory = activeFilter === "all";
        if (activeFilter !== "all") {
          matchesCategory = (card.dataset.categories || "").split(" ").includes(activeFilter);
        }
        const matches = matchesText && matchesCategory;
        card.hidden = !matches;
        if (matches) {
          visible += 1;
          reports += Number(card.dataset.reportCount || 0);
        }
      }
      if (count) count.textContent = "共 " + visible + " 只股票 · " + reports + " 份研究报告";
      if (empty) empty.hidden = visible !== 0;
    }

    function selectFilter(value) {
      activeFilter = value;
      chips.forEach((chip) => {
        const active = chip.dataset.filter === value;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", String(active));
      });
      applyFilters();
    }

    search?.addEventListener("input", applyFilters);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      applyFilters();
      document.querySelector("#library-title")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    chips.forEach((chip) => chip.addEventListener("click", () => selectFilter(chip.dataset.filter || "all")));
    views.forEach((button) => button.addEventListener("click", () => {
      const mode = button.dataset.view === "list" ? "list" : "grid";
      grid?.classList.toggle("is-list-view", mode === "list");
      views.forEach((view) => {
        const selected = view.dataset.view === mode;
        view.classList.toggle("is-active", selected);
        view.setAttribute("aria-pressed", String(selected));
      });
    }));
    document.querySelector("#reset-filters")?.addEventListener("click", () => {
      if (search) search.value = "";
      selectFilter("all");
      search?.focus();
    });
    applyFilters();
  </script>
</BaseLayout>
